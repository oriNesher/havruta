rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Access model: a challenge, its participants and its events are
    // visible only to its members (participants and organizers). What
    // other users may see of a person lives in publicProfiles; users/{uid}
    // itself (email, push tokens, Respect wallet) is private to its owner.
    // Joining a challenge is server-only (redeemInvite / acceptInvite), so
    // membership can't be self-granted. Covered by the emulator tests in
    // functions/src/rules/__tests__/.

    function signedIn() {
      return request.auth != null;
    }

    function challengeDoc(competitionId) {
      return get(/databases/$(database)/documents/competitions/$(competitionId)).data;
    }

    // A challenge without organizerUids predates the organizer role and is
    // run by its creator. Mirrors parseChallenge / Challenge.fromDoc.
    function organizersOf(challenge) {
      return challenge.get('organizerUids', [challenge.get('createdBy', '')]);
    }

    function isMemberOf(challenge) {
      return signedIn() && (
        request.auth.uid in challenge.get('participantUids', [])
        || request.auth.uid in organizersOf(challenge));
    }

    function isOrganizerOf(challenge) {
      return signedIn() && request.auth.uid in organizersOf(challenge);
    }

    // Pre-redesign Personal Goal challenges, where each participant owns
    // their goal and target. Everywhere else the goal is the challenge's.
    function isLegacyPersonal(challenge) {
      return challenge.get('winCondition', null) == null
        && challenge.get('type', '') == 'personalGoalChallenge';
    }

    // The Respect wallet is currency-like: only the grantDailyRespect and
    // giveRespect callables (Admin SDK) may change it.
    function serverOwnedUserKeys() {
      return ['respectBalance', 'respectLastGrantDate', 'totalRespectReceived'];
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Every client write path (username_screen registration, FCM token
      // save, streak update, lastCompetitionCreatedAt, seenTips) targets
      // the caller's own doc and none touches the wallet.
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(serverOwnedUserKeys());
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(serverOwnedUserKeys());
      allow delete: if false;

      match /goals/{goalId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /competitionSnapshots/{snapshotId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Written only by the giveRespect callable (Admin SDK, bypasses these
      // rules) so a client can't fabricate its own "X gave you Respect"
      // notification.
      match /respectNotifications/{notifId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Username + uid only, mirrored from users/{uid} by syncPublicProfile.
    // Backs username search and showing other people's names.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Collection-group reads against "events" (getPendingCelebrations)
    // need their own wildcard-path rule — Firestore does NOT apply the
    // nested /competitions/{id}/events/{eventId} rule below to
    // collectionGroup('events') queries. That query only ever asks for the
    // caller's own events (actorUid == caller), so that's all this allows.
    // Read-only; writes are governed solely by the nested block.
    match /{path=**}/events/{eventId} {
      allow read: if signedIn()
        && resource.data.get('actorUid', null) == request.auth.uid;
    }

    // Challenge outcome state — who won, finish order, elimination
    // progress, the Aggressor Badge holder — is socially visible, so only
    // Cloud Functions (Admin SDK) ever write it. Clients can neither seed
    // it at creation nor edit it.
    function serverOwnedChallengeKeys() {
      return ['winnerUids', 'finisherUids', 'legacyFinisherCount',
        'completedAt', 'lastEvaluatedDay', 'startingParticipantCount',
        'aggressor', 'removedUids', 'endedEarly'];
    }

    // Server-written participant fields (elimination; the streak fields
    // claimActiveDay maintains; lastCorrectionId, which marks a write as an
    // organizer correction for the progress triggers).
    function serverOwnedParticipantKeys() {
      return ['eliminatedOnDay', 'eliminatedAt', 'currentStreak',
        'lastActiveDate', 'lastCorrectionId', 'teamId'];
    }

    // Progress may only change while the challenge is still running: not
    // after it completed, and not after its end time.
    function challengeAcceptsProgress(challenge) {
      return challenge.get('status', 'active') == 'active'
        && (challenge.get('endsAt', null) == null
          || request.time < challenge.endsAt);
    }

    match /competitions/{competitionId} {
      // A missing doc reads as "doesn't exist" rather than "denied", so a
      // member still viewing a challenge its creator just deleted sees it
      // disappear instead of an error. Ids are random; nothing leaks.
      allow read: if resource == null || isMemberOf(resource.data);

      // createChallenge seeds the creator as the only organizer, and as the
      // only participant unless they're organizing without competing
      // (then participantUids starts empty). Builds from before the
      // organizer role omit organizerUids; the creator is then implied.
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.createdBy
        && request.resource.data.get('organizerUids', [request.auth.uid])
          == [request.auth.uid]
        && (request.resource.data.participantUids == [request.auth.uid]
          || (request.resource.data.participantUids == []
            && request.resource.data.get('organizerUids', []) == [request.auth.uid]))
        && request.resource.data.get('status', 'active') == 'active'
        && request.resource.data.get('winnerUid', null) == null
        && !request.resource.data.keys().hasAny(serverOwnedChallengeKeys());

      // An organizer renaming/re-describing the challenge is the only
      // client update. Every other organizer power (dates, rules, removing
      // participants, corrections, ending early, co-organizers) goes
      // through an audited callable in functions/src/organizer/; outcome
      // and membership change only server-side.
      allow update: if isOrganizerOf(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'description']);

      // Only the creator may delete a challenge. Everything under it is
      // removed by onCompetitionDeletedCleanupInviteLinks.
      allow delete: if signedIn()
        && request.auth.uid == resource.data.createdBy;

      match /participants/{participantId} {
        allow read: if isMemberOf(challengeDoc(competitionId));

        // Your own doc, once the server (or challenge creation) has put
        // you on participantUids, starting from zero progress.
        allow create: if signedIn()
          && request.auth.uid == participantId
          && request.resource.data.uid == participantId
          && request.auth.uid in challengeDoc(competitionId).get('participantUids', [])
          && request.resource.data.get('progress', 0) == 0
          && !request.resource.data.keys().hasAny(
            serverOwnedParticipantKeys().concat(['dailyProgress']));

        // Progress reports and (legacy personal challenges only) goal
        // edits on your own doc, never once eliminated, only while the
        // challenge runs. A shared goal's target belongs to the challenge:
        // standings prefer a participant's own targetValue, so letting
        // participants edit it would let them shorten their race.
        allow update: if signedIn()
          && request.auth.uid == participantId
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['progress', 'updatedAt', 'dailyProgress'])
            || (
              isLegacyPersonal(challengeDoc(competitionId))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                ['progress', 'updatedAt', 'dailyProgress', 'goalTitle',
                  'targetValue', 'unit'])
            )
          )
          && request.resource.data.get('progress', 0) is number
          && request.resource.data.get('progress', 0) >= 0
          && !('eliminatedOnDay' in resource.data)
          && challengeAcceptsProgress(challengeDoc(competitionId));

        // Server-only: challenge deletion cascades in a Cloud Function.
        allow delete: if false;
      }

      // Progress entries (corrections now; proof-backed reports later).
      // Private to the participant they belong to and the organizers.
      // Written only by Cloud Functions for now.
      match /entries/{entryId} {
        allow read: if signedIn() && (
          resource.data.uid == request.auth.uid
          || isOrganizerOf(challengeDoc(competitionId)));
        allow write: if false;
      }

      // Organizer-only notes about each participant: the manual "paid"
      // flag (fees are collected outside the app during the pilot; later
      // registration answers and payment records would live here too).
      // Written directly by organizers, stamped with who and when. Not on
      // the participant doc, which every participant can read.
      match /organizerData/{participantUid} {
        allow read: if isOrganizerOf(challengeDoc(competitionId));
        allow create, update: if isOrganizerOf(challengeDoc(competitionId))
          && request.resource.data.keys().hasOnly(
            ['paid', 'paidUpdatedBy', 'paidUpdatedAt'])
          && request.resource.data.paid is bool
          && request.resource.data.paidUpdatedBy == request.auth.uid
          && request.resource.data.paidUpdatedAt == request.time;
        allow delete: if false;
      }

      // Teams (manageTeams callable): a team leaderboard and, in a large
      // challenge, an audience. Every member reads them; membership lives
      // on participants/{uid}.teamId, server-owned.
      match /teams/{teamId} {
        allow read: if isMemberOf(challengeDoc(competitionId));
        allow write: if false;
      }

      // Who a member follows inside this challenge (large challenges show
      // you their activity wherever they are on the leaderboard). Private
      // to the follower: nobody sees who follows whom. The server reads
      // them to address events.
      match /follows/{followerUid} {
        allow read, delete: if signedIn() && request.auth.uid == followerUid;
        allow create, update: if signedIn()
          && request.auth.uid == followerUid
          && isMemberOf(challengeDoc(competitionId))
          && request.resource.data.keys().hasOnly(['followingUids'])
          && request.resource.data.followingUids is list
          && request.resource.data.followingUids.size() <= 50;
      }

      // Organizer announcements (sendAnnouncement callable), for every
      // member to read.
      match /announcements/{announcementId} {
        allow read: if isMemberOf(challengeDoc(competitionId));
        allow write: if false;
      }

      // Who did what, when, and why — organizers only, server-written so
      // it can't be edited after the fact.
      match /auditLog/{recordId} {
        allow read: if isOrganizerOf(challengeDoc(competitionId));
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if isMemberOf(challengeDoc(competitionId));
        // Only Cloud Functions (Admin SDK, bypasses rules) create/delete
        // events. dismissEventsForUser and markEventsCelebrated are the two
        // client writes: removing the caller's own uid from
        // unseenByUserUids, or the event's actor flipping actorCelebrated.
        allow create, delete: if false;
        allow update: if signedIn()
          && request.auth.uid in resource.data.unseenByUserUids
          && !(request.auth.uid in request.resource.data.unseenByUserUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unseenByUserUids']);
        // markEventsCelebrated: only the actor, only false -> true, and only
        // once (resource.data.actorCelebrated == false guards against a
        // caller replaying the write after it already landed).
        allow update: if signedIn()
          && request.auth.uid == resource.data.actorUid
          && resource.data.actorCelebrated == false
          && request.resource.data.actorCelebrated == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actorCelebrated']);
      }
    }

    // Direct (username/email) invites. They carry a copy of the challenge's
    // definition, so the recipient never needs to read the challenge
    // itself before joining. Accepting goes through the acceptInvite
    // callable; the client only ever declines.
    match /competition_invites/{inviteId} {
      allow read: if signedIn() && (
        resource.data.toUid == request.auth.uid
        || resource.data.fromUid == request.auth.uid
        || isMemberOf(challengeDoc(resource.data.competitionId)));
      // Only into a challenge you're in, from yourself, to someone else.
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && isMemberOf(challengeDoc(request.resource.data.competitionId));
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'declined'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // The sender withdrawing it, or the challenge's organizer.
      // Challenge deletion removes the rest server-side.
      allow delete: if signedIn() && (
        resource.data.fromUid == request.auth.uid
        || isOrganizerOf(challengeDoc(resource.data.competitionId)));
    }

    // Reusable invite links are a bearer credential — whoever holds the
    // token (the link) can use it. All access goes through the
    // createInvite / getInvite / redeemInvite / revokeInvite callables
    // (Admin SDK, bypasses these rules) so validity, expiry, capacity,
    // and revocation are enforced in one server-side place. The client
    // app never reads or writes these collections directly.
    match /challenge_invite_links/{linkId} {
      allow read, write: if false;

      match /redemptions/{uid} {
        allow read, write: if false;
      }
    }
  }
}
