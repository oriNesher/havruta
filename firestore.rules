rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reads stay as open as the current live rules (any signed-in user) —
    // this file only tightens writes, to minimize regression risk against
    // flows not covered below. See PR/commit notes for the client call
    // sites each write rule was traced against.

    match /users/{uid} {
      allow read: if request.auth != null;
      // Every client write path (username_screen registration, FCM token
      // save, streak update, lastCompetitionCreatedAt) always targets the
      // caller's own doc.
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /goals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /competitionSnapshots/{snapshotId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Written only by the giveRespect callable (Admin SDK, bypasses these
      // rules) so a client can't fabricate its own "X gave you Respect"
      // notification.
      match /respectNotifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Collection-group reads against "events" (getPendingCelebrations,
    // getHomeEvents) need their own wildcard-path rule — Firestore does
    // NOT apply the nested /competitions/{id}/events/{eventId} rule below
    // to collectionGroup('events') queries, only to direct subcollection
    // reads of one competition's events. Read-only; writes are still
    // governed solely by the nested block, since this one is silent on
    // create/update/delete.
    match /{path=**}/events/{eventId} {
      allow read: if request.auth != null;
    }

    match /competitions/{competitionId} {
      allow read: if request.auth != null;

      // createCompetition/createSharedGoalCompetition always seed
      // participantUids with only the creator.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && request.resource.data.participantUids == [request.auth.uid];

      // Two allowed update shapes: the creator changing their own
      // challenge, or a self-join adding exactly the caller's own uid to
      // participantUids (acceptCompetitionInvite / addParticipant /
      // redeemInvite's client-visible shape — redeemInvite itself runs
      // via Admin SDK and bypasses this, but direct client self-joins hit
      // this path).
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids']) &&
          request.auth.uid in request.resource.data.participantUids &&
          request.resource.data.participantUids.size() == resource.data.participantUids.size() + 1 &&
          request.resource.data.participantUids.hasAll(resource.data.participantUids)
        )
      );

      // Only the creator may delete a challenge (matches the existing
      // deleteCompetition doc comment).
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      match /participants/{participantId} {
        allow read: if request.auth != null;
        // Every client write always targets the caller's own participant
        // doc (createCompetition, acceptCompetitionInvite,
        // updateProgress, updateParticipantGoal all pass uid = caller).
        allow create, update: if request.auth != null && request.auth.uid == participantId;
        // deleteCompetition (creator-only, cascades from the UI) deletes
        // the competition doc first, then loops participant docs — by
        // that point the parent doc is already gone, so a creator check
        // here can't reliably re-verify against it. Left as-is (same
        // permissiveness as the current live rules) rather than risk
        // breaking the delete-challenge feature; not the focus of this
        // pass, which is closing the invite-link bearer-token gap.
        allow delete: if request.auth != null;
      }

      match /events/{eventId} {
        allow read: if request.auth != null;
        // Only Cloud Functions (Admin SDK, bypasses rules) create/delete
        // events. dismissEventsForUser and markEventsCelebrated are the two
        // client writes: removing the caller's own uid from
        // unseenByUserUids, or the event's actor flipping actorCelebrated.
        allow create, delete: if false;
        allow update: if request.auth != null
          && request.auth.uid in resource.data.unseenByUserUids
          && !(request.auth.uid in request.resource.data.unseenByUserUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unseenByUserUids']);
        // markEventsCelebrated: only the actor, only false -> true, and only
        // once (resource.data.actorCelebrated == false guards against a
        // caller replaying the write after it already landed).
        allow update: if request.auth != null
          && request.auth.uid == resource.data.actorUid
          && resource.data.actorCelebrated == false
          && request.resource.data.actorCelebrated == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actorCelebrated']);
      }
    }

    match /competition_invites/{inviteId} {
      allow read: if request.auth != null;
      // sendCompetitionInvite always writes fromUid = the caller.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
      // accept/decline are always performed by the invite's recipient.
      allow update: if request.auth != null && request.auth.uid == resource.data.toUid;
      // Same ordering caveat as competitions/participants delete above —
      // deleteCompetition removes these after the parent competition doc
      // is already gone. Left permissive, matching current behavior.
      allow delete: if request.auth != null;
    }

    // Reusable invite links are a bearer credential — whoever holds the
    // token (the link) can use it. All access goes through the
    // createInvite / getInvite / redeemInvite / revokeInvite callables
    // (Admin SDK, bypasses these rules) so validity, expiry, capacity,
    // and revocation are enforced in one server-side place. The client
    // app never reads or writes these collections directly.
    match /challenge_invite_links/{linkId} {
      allow read, write: if false;

      match /redemptions/{uid} {
        allow read, write: if false;
      }
    }
  }
}
