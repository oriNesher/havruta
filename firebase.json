{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "havruta-app",
          "appId": "1:943688238219:android:a436e63155008cb743c08e",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "havruta-app",
          "appId": "1:943688238219:ios:792c2db6a957168343c08e",
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "havruta-app",
          "configurations": {
            "android": "1:943688238219:android:a436e63155008cb743c08e",
            "ios": "1:943688238219:ios:792c2db6a957168343c08e",
            "web": "1:943688238219:web:64ffe33b31f0850043c08e"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "_comment_public": "The BUILT app, not the web/ source folder. Deploying web/ ships an index.html whose flutter_bootstrap.js was never generated, i.e. a blank page. Always run `flutter build web` immediately before deploying.",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!/.well-known/**",
      "**/node_modules/**"
    ],
    "_comment_rewrites": "ORDER MATTERS: Firebase takes the first match. /i/** must stay above the SPA catch-all, or invite links stop reaching inviteLanding and the link-preview cards that messaging apps scrape go with them. Real files (privacy.html, .well-known/*) are served before any rewrite is considered.",
    "rewrites": [
      {
        "source": "/i/**",
        "function": "inviteLanding"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "_comment": "Flutter does not content-hash main.dart.js, so a cached shell pointing at a previous deploy's assets is the failure mode to avoid. These three decide what everything else resolves to, so they must never be stale. Other assets keep Firebase's safe 1-hour default. Listed separately rather than as one extglob, which silently matched nothing.",
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
